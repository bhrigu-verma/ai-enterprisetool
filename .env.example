# ──────────────────────────────────────────────
# AI Enterprise Tool — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# All settings are prefixed with AET_.

# ── Application ──────────────────────────────
AET_APP_NAME="AI Enterprise Tool"
AET_COMPANY_NAME="Acme Corp"
AET_DEBUG=false

# ── API Authentication ───────────────────────
# Comma-separated list of valid API keys for authenticating requests.
# Generate strong random keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
AET_API_KEYS=

# ── Anthropic (LLM) ─────────────────────────
AET_ANTHROPIC_API_KEY=
AET_OPUS_MODEL=claude-sonnet-4-20250514
AET_SONNET_MODEL=claude-sonnet-4-20250514
AET_MAX_CONTEXT_TOKENS=150000
AET_LLM_MAX_OUTPUT_TOKENS=4096
AET_LLM_TIMEOUT_SECONDS=120

# ── GitHub ───────────────────────────────────
AET_GITHUB_TOKEN=
AET_GITHUB_WEBHOOK_SECRET=

# ── Slack ────────────────────────────────────
AET_SLACK_BOT_TOKEN=
AET_SLACK_SIGNING_SECRET=
AET_SLACK_INDEXED_CHANNELS=["C_engineering","C_architecture","C_incidents"]

# ── Qdrant (Vector Store) ────────────────────
AET_QDRANT_URL=http://localhost:6333
AET_QDRANT_API_KEY=
AET_QDRANT_COLLECTION=enterprise_knowledge

# ── PostgreSQL ───────────────────────────────
AET_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aet

# ── Redis ────────────────────────────────────
AET_REDIS_URL=redis://localhost:6379/0

# ── Embedding ────────────────────────────────
AET_EMBEDDING_MODEL=text-embedding-3-large
AET_EMBEDDING_DIMENSION=3072
AET_OPENAI_API_KEY=

# ── Staleness ────────────────────────────────
AET_STALENESS_THRESHOLD_DAYS=540

# ── Rate Limiting ────────────────────────────
AET_RATE_LIMIT_PER_MINUTE=60
AET_RATE_LIMIT_BURST=10

# ── Request Limits ───────────────────────────
AET_MAX_QUERY_LENGTH=10000
AET_MAX_INGEST_BATCH_SIZE=100
